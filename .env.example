# =====================================================================
# Turso Database Configuration (Recommended - Free Serverless libSQL)
# Get these from Turso Dashboard (https://turso.tech) or `turso db show --url` & `turso db tokens create`
# =====================================================================
VITE_TURSO_DATABASE_URL=https://your-db-name-your-user.turso.io
VITE_TURSO_AUTH_TOKEN=your-turso-auth-jwt-token

# =====================================================================
# Supabase Configuration (Alternative - Free PostgreSQL)
# =====================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
